# Variaveis NAO sensiveis do Billing em prd. Credenciais (JWT, banco, service token e Mercado Pago)
# vem de Secrets criados pela pipeline a partir do Secrets Manager.

# Carrega o dd-java-agent embarcado na imagem. Sobrescreve o JAVA_OPTS do Dockerfile, por isso o
# MaxRAMPercentage e repetido.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -javaagent:/app/dd-java-agent.jar

DD_ENV=prd
AMBIENTE=prd

# Saga (ADR 0005): consome oficina-prd-billing-commands.fifo e responde em os-saga-replies, com as
# credenciais da Role IRSA.
MENSAGERIA_SQS_HABILITADO=true

# Precos das pecas: POST /internal/pecas-insumos/consulta na Execution (Service oficina-execution-service
# do mesmo namespace, porta 8080), com o X-Service-Token.
CATALOGO_PECAS_URL=http://oficina-execution-service:8080

# Credenciais de teste do Mercado Pago nos dois ambientes do desafio: link do sandbox.
MERCADOPAGO_SANDBOX=true

# Acrescentados pela pipeline: DB_URL, PAGAMENTO_GATEWAY (mercadopago, ou simulado em hml sem o
# segredo do Mercado Pago), MERCADOPAGO_NOTIFICATION_URL e DD_VERSION (tag da imagem).
