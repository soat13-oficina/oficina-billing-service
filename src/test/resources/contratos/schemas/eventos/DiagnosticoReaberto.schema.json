{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soat13-oficina.github.io/contratos/schemas/eventos/DiagnosticoReaberto.schema.json",
  "title": "DiagnosticoReaberto",
  "description": "Confirmacao da compensacao: diagnostico reaberto (etapa EM_DIAGNOSTICO).",
  "x-categoria": "evento",
  "x-fila": "oficina-<env>-os-saga-replies.fifo",
  "x-produtor": "oficina-execution-service",
  "x-consumidor": "oficina-os-service",
  "x-em-resposta-a": "ReabrirDiagnostico",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "DiagnosticoReaberto"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "oficina-execution-service"
    },
    "causationId": {
      "$ref": "../comuns.schema.json#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "reabertoEm"
      ],
      "properties": {
        "reabertoEm": {
          "$ref": "../comuns.schema.json#/$defs/dataHora"
        }
      }
    }
  },
  "examples": [
    {
      "messageId": "00000000-0000-4000-8000-000000000015",
      "type": "DiagnosticoReaberto",
      "version": 1,
      "sagaId": "6f0e2b8a-1c3d-4e5f-8a9b-0c1d2e3f4a5b",
      "ordemServicoId": "3c9a1b2d-4e5f-4a7b-8c9d-0e1f2a3b4c5d",
      "correlationId": "Yx2kLh1MIAMEJbQ=",
      "causationId": "00000000-0000-4000-8000-000000000002",
      "occurredAt": "2026-10-15T13:00:00Z",
      "source": "oficina-execution-service",
      "payload": {
        "reabertoEm": "2026-10-15T13:41:00Z"
      }
    }
  ]
}
