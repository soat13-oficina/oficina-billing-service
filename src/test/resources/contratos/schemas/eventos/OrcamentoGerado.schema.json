        "orcamentoId": {
          "$ref": "../comuns.schema.json#/$defs/uuid"
        },
        "numeroOrcamento": {
          "type": "string",
          "minLength": 1
        },
        "valorMaoDeObra": {
          "$ref": "../comuns.schema.json#/$defs/dinheiro"
        },
        "valorPecas": {
          "$ref": "../comuns.schema.json#/$defs/dinheiro"
        },
        "desconto": {
          "$ref": "../comuns.schema.json#/$defs/dinheiro"
        },
        "valorTotal": {
          "$ref": "../comuns.schema.json#/$defs/dinheiro"
        },
        "validade": {
          "$ref": "../comuns.schema.json#/$defs/dataHora"
        }
      }
    }
  },
  "examples": [
    {
      "messageId": "00000000-0000-4000-8000-000000000024",
      "type": "OrcamentoGerado",
      "version": 1,
      "sagaId": "6f0e2b8a-1c3d-4e5f-8a9b-0c1d2e3f4a5b",
      "ordemServicoId": "3c9a1b2d-4e5f-4a7b-8c9d-0e1f2a3b4c5d",
