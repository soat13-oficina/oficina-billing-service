      "source": "oficina-billing-service",
      "payload": {
        "orcamentoId": "9d2c4e6f-8a1b-4c3d-9e5f-7a6b5c4d3e2f",
        "numeroOrcamento": "ORC-20261015-0042",
        "valorMaoDeObra": "300.00",
        "valorPecas": "230.00",
        "desconto": "0.00",
        "valorTotal": "530.00",
        "validade": "2026-10-22T13:41:00Z"
      }
    }
  ]
}
