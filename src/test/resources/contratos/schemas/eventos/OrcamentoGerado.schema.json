{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soat13-oficina.github.io/contratos/schemas/eventos/OrcamentoGerado.schema.json",
  "title": "OrcamentoGerado",
  "description": "Orcamento criado e aguardando aprovacao do cliente.",
  "x-categoria": "evento",
  "x-fila": "oficina-<env>-os-saga-replies.fifo",
  "x-produtor": "oficina-billing-service",
  "x-consumidor": "oficina-os-service",
  "x-em-resposta-a": "GerarOrcamento",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "OrcamentoGerado"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "oficina-billing-service"
    },
    "causationId": {
      "$ref": "../comuns.schema.json#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "required": [
        "orcamentoId",
        "numeroOrcamento",
        "valorMaoDeObra",
        "valorPecas",
        "desconto",
        "valorTotal",
        "validade"
      ],
