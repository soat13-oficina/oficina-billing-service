{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soat13-oficina.github.io/contratos/schemas/eventos/DiagnosticoConcluido.schema.json",
  "title": "DiagnosticoConcluido",
  "description": "Mecanico concluiu o diagnostico com servicos (mao de obra de cada um) e pecas previstas. Dispara GerarOrcamento.",
  "x-categoria": "evento",
  "x-fila": "oficina-<env>-os-saga-replies.fifo",
  "x-produtor": "oficina-execution-service",
  "x-consumidor": "oficina-os-service",
  "x-em-resposta-a": null,
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "DiagnosticoConcluido"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "oficina-execution-service"
    },
    "causationId": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "required": [
        "mecanico",
        "descricaoDiagnostico",
        "servicos",
        "pecas",
        "concluidoEm"
      ],
      "properties": {
        "mecanico": {
          "$ref": "../comuns.schema.json#/$defs/mecanico"
        },
        "descricaoDiagnostico": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "servicos": {
          "type": "array",
          "items": {
            "$ref": "../comuns.schema.json#/$defs/servico"
          },
          "minItems": 1
        },
        "pecas": {
          "type": "array",
          "items": {
            "$ref": "../comuns.schema.json#/$defs/itemPeca"
          }
        },
        "concluidoEm": {
          "$ref": "../comuns.schema.json#/$defs/dataHora"
        }
      }
    }
  },
  "examples": [
    {
      "messageId": "00000000-0000-4000-8000-000000000014",
      "type": "DiagnosticoConcluido",
      "version": 1,
      "sagaId": "6f0e2b8a-1c3d-4e5f-8a9b-0c1d2e3f4a5b",
      "ordemServicoId": "3c9a1b2d-4e5f-4a7b-8c9d-0e1f2a3b4c5d",
      "correlationId": "Yx2kLh1MIAMEJbQ=",
      "causationId": null,
      "occurredAt": "2026-10-15T13:00:00Z",
      "source": "oficina-execution-service",
      "payload": {
        "mecanico": {
          "id": "mecanico@oficina.com",
          "nome": "Joao Mecanico"
        },
        "descricaoDiagnostico": "Oleo vencido e pastilhas dianteiras no limite",
        "servicos": [
          {
            "descricao": "Troca de oleo e filtro",
            "valorMaoDeObra": "120.00"
          },
          {
            "descricao": "Substituicao das pastilhas dianteiras",
            "valorMaoDeObra": "180.00"
          }
        ],
        "pecas": [
          {
