      "causationId": "00000000-0000-4000-8000-000000000005",
      "occurredAt": "2026-10-15T13:00:00Z",
      "source": "oficina-execution-service",
      "payload": {
        "itens": [
          {
            "pecaInsumoId": "5e8f1a2b-3c4d-4e5f-8a6b-7c8d9e0f1a2b",
