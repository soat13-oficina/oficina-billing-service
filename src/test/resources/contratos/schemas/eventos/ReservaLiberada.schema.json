{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soat13-oficina.github.io/contratos/schemas/eventos/ReservaLiberada.schema.json",
  "title": "ReservaLiberada",
  "description": "Confirmacao da compensacao: pecas nao consumidas voltaram ao estoque disponivel.",
