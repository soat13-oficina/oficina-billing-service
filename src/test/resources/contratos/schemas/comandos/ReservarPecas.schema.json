{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soat13-oficina.github.io/contratos/schemas/comandos/ReservarPecas.schema.json",
  "title": "ReservarPecas",
  "description": "Reserva atomicamente as pecas do orcamento aprovado (tudo ou nada). Lista vazia confirma sem reservar.",
  "x-categoria": "comando",
  "x-fila": "oficina-<env>-execution-commands.fifo",
  "x-produtor": "oficina-os-service",
  "x-consumidor": "oficina-execution-service",
  "x-respostas": [
    "PecasReservadas",
    "ReservaFalhou"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ReservarPecas"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "oficina-os-service"
    },
    "causationId": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "required": [
        "orcamentoId",
        "itens"
      ],
      "properties": {
        "orcamentoId": {
          "$ref": "../comuns.schema.json#/$defs/uuid"
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "../comuns.schema.json#/$defs/itemPeca"
          }
        }
      }
    }
  },
  "examples": [
    {
      "messageId": "00000000-0000-4000-8000-000000000003",
      "type": "ReservarPecas",
      "version": 1,
      "sagaId": "6f0e2b8a-1c3d-4e5f-8a9b-0c1d2e3f4a5b",
      "ordemServicoId": "3c9a1b2d-4e5f-4a7b-8c9d-0e1f2a3b4c5d",
      "correlationId": "Yx2kLh1MIAMEJbQ=",
      "causationId": null,
      "occurredAt": "2026-10-15T13:00:00Z",
      "source": "oficina-os-service",
      "payload": {
        "orcamentoId": "9d2c4e6f-8a1b-4c3d-9e5f-7a6b5c4d3e2f",
        "itens": [
          {
            "pecaInsumoId": "5e8f1a2b-3c4d-4e5f-8a6b-7c8d9e0f1a2b",
            "quantidade": 1
          },
          {
            "pecaInsumoId": "8a9b0c1d-2e3f-4a5b-9c6d-7e8f9a0b1c2d",
            "quantidade": 2
          }
        ]
      }
    }
  ]
}
